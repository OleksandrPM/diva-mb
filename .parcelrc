{
  "extends": [
    "@parcel/config-default"
  ],
  "compressors": {
    "*.{html,css,js,svg,map}": [
      "...",
      "@parcel/compressor-gzip",
      "@parcel/compressor-brotli"
    ]
  },
  "optimizers": {
    "*.svg": []
  },
  "reporters": [
    "...",
    "parcel-reporter-clean-dist"
  ]
}
